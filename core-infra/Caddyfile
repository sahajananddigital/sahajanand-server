# ==============================================================================
# App Reverse Proxy Definitions
# Containers communicate across the external 'proxy_net' bridge network.
# ==============================================================================

# Gitea
git.app.sahajananddigital.in, git.localhost, http://git.localhost {
	encode zstd gzip
	reverse_proxy gitea:3000
}

# Uptime Kuma
status.app.sahajananddigital.in, status.localhost, http://status.localhost {
	encode zstd gzip
	reverse_proxy uptime_kuma:3001
}

# OpenWA
wa.app.sahajananddigital.in, wa.localhost, http://wa.localhost {
	encode zstd gzip
	reverse_proxy openwa:2785
}
