# ==============================================================================
# App Reverse Proxy Definitions
# Containers communicate across the external 'proxy_net' bridge network.
# ==============================================================================

# Gitea
git.app.sahajananddigital.in, git.localhost, http://git.localhost {
	encode zstd gzip
	reverse_proxy gitea:3000
}

# Uptime Kuma
status.app.sahajananddigital.in, status.localhost, http://status.localhost {
	encode zstd gzip
	reverse_proxy uptime_kuma:3001
}

# OpenWA
wa.app.sahajananddigital.in, wa.localhost, http://wa.localhost {
	encode zstd gzip
	reverse_proxy openwa:2785
}

# Invoice Ninja (Invoicing & Billing)
invoice.app.sahajananddigital.in, invoice.localhost, http://invoice.localhost, erp.app.sahajananddigital.in, erp.localhost, http://erp.localhost {
	encode zstd gzip
	reverse_proxy invoiceninja_server:80
}

# FreeScout (Help Desk & Shared Inbox)
help.app.sahajananddigital.in, support.app.sahajananddigital.in, help.localhost, http://help.localhost {
	encode zstd gzip
	reverse_proxy freescout:80
}

# DocuSeal (Document Signing & e-Signatures)
sign.app.sahajananddigital.in, docuseal.app.sahajananddigital.in, sign.localhost, http://sign.localhost, docuseal.localhost, http://docuseal.localhost {
	encode zstd gzip
	reverse_proxy docuseal:3000
}

# n8n (Workflow Automation & Integrations)
automate.app.sahajananddigital.in, n8n.app.sahajananddigital.in, automate.localhost, http://automate.localhost, n8n.localhost, http://n8n.localhost {
	encode zstd gzip
	reverse_proxy n8n:5678
}
