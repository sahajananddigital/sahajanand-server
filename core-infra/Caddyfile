# ==============================================================================
# App Reverse Proxy Definitions
# Containers communicate across the external 'proxy_net' bridge network.
# ==============================================================================

git.example.com, git.localhost, http://git.localhost {
	encode zstd gzip
	reverse_proxy gitea:3000
}

status.example.com, status.localhost, http://status.localhost {
	encode zstd gzip
	reverse_proxy uptime_kuma:3001
}

wa.example.com, wa.localhost, http://wa.localhost {
	encode zstd gzip
	reverse_proxy openwa:2785
}
