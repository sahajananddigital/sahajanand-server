# ==============================================================================
# Gitea Application Environment Variables
# ==============================================================================

# Database Settings (Provisioned on shared_mariadb via scripts/create-db.sh)
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=CHANGE_ME_GITEA_DB_PASSWORD

# Domain Settings
GITEA_DOMAIN=git.example.com
