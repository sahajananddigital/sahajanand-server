# ==============================================================================
# n8n Workflow Automation Environment Configuration
# ==============================================================================

# Application & Domain Configuration
N8N_HOST=automate.app.sahajananddigital.in
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://automate.app.sahajananddigital.in/
GENERIC_TIMEZONE=UTC

# Execution Data Pruning (Crucial for SQLite stability & SSD space preservation)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# Telemetry & Performance Tuning
N8N_METRICS=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
