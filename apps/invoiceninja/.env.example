# ==============================================================================
# Invoice Ninja Environment Configuration
# ==============================================================================

# Application URL
APP_URL=https://erp.app.sahajananddigital.in
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_OPENSSL_OR_ARTISAN
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false
PHANTOMJS_PDF_GENERATION=false
PDF_GENERATOR=hosted_ninja
TRUSTED_PROXIES=*

# Database Connection (shared_mariadb)
DB_CONNECTION=mysql
DB_HOST=shared_mariadb
DB_PORT=3306
DB_DATABASE=invoiceninja
DB_USERNAME=invoiceninja
DB_PASSWORD=CHANGE_ME_NINJA_DB_PASSWORD

# Redis Cache & Queue (shared_redis)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=shared_redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Initial Administrator Credentials (auto-generated on first boot)
IN_USER_EMAIL=admin@sahajananddigital.in
IN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
