# ==============================================================================
# DocuSeal Environment Configuration
# ==============================================================================

# Application & Domain Configuration
HOST=sign.app.sahajananddigital.in
FORCE_SSL=true
PORT=3000

# Secret Key Base (Required for session integrity and encryption)
# Generate using: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME_DOCUSEAL_SECRET_KEY_BASE

# Database Configuration
# Default: Embedded SQLite stored persistently on docuseal_data volume (/data/docuseal/db.sqlite3)
# To use shared_mariadb instead, provision with ./scripts/create-db.sh docuseal <password> and uncomment:
# Note: DocuSeal (Rails 8) uses the Trilogy adapter (trilogy://) for MySQL/MariaDB
# DATABASE_URL=trilogy://docuseal:CHANGE_ME_DOCUSEAL_DB_PASSWORD@shared_mariadb:3306/docuseal

# Storage Configuration
# Default is local filesystem storage inside /data
STORAGE_TYPE=local

# SMTP / Email Configuration (Optional - for signature request notifications)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@sahajananddigital.in
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# SMTP_AUTHENTICATION=plain
# SMTP_FROM=sign@sahajananddigital.in
# SMTP_DOMAIN=sahajananddigital.in
# SMTP_ENABLE_STARTTLS=true
